NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key-here"
LINEAR_API_KEY="linear-api-key"

# Optional: Cloudflare Turnstile for the newsletter forms. Leave both unset to disable.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
# TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Our own analytics (docs/analytics/README.md). All optional: with none set,
# development uses a local file store and production keeps nothing.
# Its own Supabase settings, separate from the newsletter's above on purpose.
# ANALYTICS_SUPABASE_URL="https://your-analytics-project-id.supabase.co"
# ANALYTICS_SUPABASE_SERVICE_KEY="your-service-role-or-secret-key"
# The /analytics dashboard's password. Without it the dashboard is a 404 in production.
# ANALYTICS_PASSWORD="choose-a-long-password"
# More origins allowed to send events, comma-separated (the site's own host always is).
# ANALYTICS_ALLOWED_ORIGINS="https://example.com"
# Local only: use the file store under `next start`, and let Playwright's browsers through.
# ANALYTICS_STORE="local"
# ANALYTICS_ALLOW_AUTOMATION="1"
